# Price Intelligence OS — environment configuration
# Copy to .env (or set in your process manager / container). Every value is optional in development.

# HTTP
PORT=4000
HOST=0.0.0.0
# Set to "true" when running behind a TLS-terminating reverse proxy (enables X-Forwarded-* handling).
PIOS_TRUST_PROXY=false

# Storage: SQLite database, uploaded evidence files and the generated secret key live here.
PIOS_DATA_DIR=./data

# First administrator. In production, if these are unset a random password is generated and printed once.
PIOS_ADMIN_EMAIL=
PIOS_ADMIN_PASSWORD=

# Encryption key for stored integration credentials (API keys, SMTP password).
# If unset, a key file is generated in PIOS_DATA_DIR/secret.key on first start.
PIOS_SECRET_KEY=

# Demo dataset: "true" loads the clearly-labelled DEMO dataset on first start of an empty database.
PIOS_SEED_DEMO=true

# Background scheduler for always-on collection ("off" disables it, e.g. for one-off CLI use).
PIOS_SCHEDULER=on

# Outbound collection
# Identify your organisation honestly to the sites/APIs you are permitted to access.
PIOS_USER_AGENT=PriceIntelligenceOS/1.0
# Allow connectors to reach private/loopback addresses (needed for on-prem feeds; keep false on the public internet).
PIOS_ALLOW_PRIVATE_NETWORK=false

# AI assistant (optional). Can also be configured in Administration → Integrations.
ANTHROPIC_API_KEY=
