# Price Intelligence OS — environment configuration
# Copy to .env (read automatically by `npm start`, `npm run dev` and the db:* commands) or set these in your
# process manager / container. Every value is optional in development.

# ── HTTP ────────────────────────────────────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
# Set to "true" when running behind a TLS-terminating reverse proxy (enables X-Forwarded-* handling and
# secure cookies).
PIOS_TRUST_PROXY=false
# debug | info | warn | error  (default: info in production, warn otherwise)
LOG_LEVEL=
# Allow other sites to show the app inside a frame (embedded previews, an intranet portal). Default: refused
# in production, allowed otherwise. Leave off unless you need it.
PIOS_ALLOW_EMBEDDING=

# ── Storage ─────────────────────────────────────────────────────────────────────────────────────────────
# The SQLite database, uploaded evidence files, import files, the Excel mirror and the generated secret key
# all live here. Back this directory up; mount it as a volume in containers.
PIOS_DATA_DIR=./data

# ── Accounts ────────────────────────────────────────────────────────────────────────────────────────────
# First administrator, created on an empty database. If unset in production, an administrator with a random
# one-time password is created and printed once in the server log.
PIOS_ADMIN_EMAIL=
PIOS_ADMIN_PASSWORD=
# Three demo accounts (admin@ / analyst@ / viewer@priceintel.local) with a documented password.
# Default: on outside production, off in production. Never enable on an internet-facing installation.
PIOS_DEMO_ACCOUNTS=

# Encryption key for stored integration credentials (API keys, SMTP password, retailer credentials).
# If unset, a key file is generated at PIOS_DATA_DIR/secret.key on first start. Keep it with your backups:
# without it stored credentials cannot be decrypted.
PIOS_SECRET_KEY=

# ── Demo dataset ────────────────────────────────────────────────────────────────────────────────────────
# "true" loads the clearly labelled DEMO dataset (fictional prices) on first start of an empty database.
# Remove it later in Administration → Database, or with `npm run db:purge-demo`.
PIOS_SEED_DEMO=true

# ── Collection ──────────────────────────────────────────────────────────────────────────────────────────
# Background scheduler for always-on collection ("off" disables it; collection can still be run manually).
PIOS_SCHEDULER=on
# A collection job that runs longer than this is marked failed.
PIOS_JOB_TIMEOUT_MINUTES=30
# Identify your organisation honestly to the sites and APIs you are permitted to access.
PIOS_USER_AGENT=PriceIntelligenceOS/1.0
# Allow connectors to reach private / loopback addresses (needed for on-premise feeds; keep false when the
# server can reach networks you do not control). Default: true outside production, false in production.
PIOS_ALLOW_PRIVATE_NETWORK=false
# If outbound traffic must go through an HTTP(S) proxy, set HTTPS_PROXY / HTTP_PROXY / NO_PROXY as usual and
# also NODE_USE_ENV_PROXY=1 so that Node's built-in fetch honours them.
# NODE_USE_ENV_PROXY=1

# ── Excel ───────────────────────────────────────────────────────────────────────────────────────────────
# Keep an always-current Excel copy of the whole database at PIOS_DATA_DIR/exports/price-intelligence-database.xlsx
PIOS_EXCEL_MIRROR=on
# How often the Excel copy is rewritten when data has changed.
PIOS_EXCEL_MIRROR_MINUTES=60
# Largest observation export (CSV / Excel) a user may download in one file.
PIOS_EXPORT_MAX_ROWS=250000

# ── AI assistant (optional) ─────────────────────────────────────────────────────────────────────────────
# The assistant answers from stored observations with its built-in query engine. With an Anthropic API key
# it also uses Claude to interpret free-form questions (numbers still come only from the database).
# Can be set here or in Administration → Integrations.
ANTHROPIC_API_KEY=
