{
  "name": "price-intelligence-os",
  "version": "1.0.0",
  "description": "Price Intelligence OS — always-on FMCG competitive pricing intelligence platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --only api",
    "dev:client": "node scripts/dev.mjs --only web",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "test": "node --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "cli": "node server/cli.ts",
    "db:migrate": "node server/cli.ts migrate",
    "db:status": "node server/cli.ts status",
    "db:seed-demo": "node server/cli.ts seed-demo",
    "db:purge-demo": "node server/cli.ts purge-demo",
    "db:export-excel": "node server/cli.ts export-excel",
    "db:backup": "node server/cli.ts backup"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
